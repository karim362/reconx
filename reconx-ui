#!/data/data/com.termux/files/usr/bin/bash
# ReconX Interactive UI v3.1

cd ~/reconx
export PYTHONPATH="$PWD:$PYTHONPATH"
export TERM=xterm-256color

clear
echo ""
echo "╔══════════════════════════════════════════╗"
echo "║   ReconX — Interactive Recon Tool v3.1   ║"
echo "║   Termux Edition | 12 passive sources    ║"
echo "╚══════════════════════════════════════════╝"
echo ""

read -p "🎯 Target domain: " DOMAIN
if [ -z "$DOMAIN" ]; then
    echo "❌ Domain required"
    exit 1
fi
DOMAIN=$(echo "$DOMAIN" | sed 's|https\?://||' | cut -d'/' -f1 | tr '[:upper:]' '[:lower:]')

echo ""
echo "📋 Scan modes:"
echo ""
echo "  [1] 🚀 Fast      — ~1-2 min  (passive + probe)"
echo "  [2] ⚡ Standard  — ~3-5 min  (fast + crawl + ports)"
echo "  [3] 🔥 Full      — ~8-15 min (everything + nuclei)"
echo "  [4] 🎯 Custom    — choose flags"
echo "  [5] 🌐 Web UI    — open dashboard"
echo ""
read -p "Choice [1-5]: " CHOICE

case $CHOICE in
    1) FLAGS="--fast"; TYPE="Fast" ;;
    2) FLAGS="--crawl --httpx"; TYPE="Standard" ;;
    3) FLAGS="--all"; TYPE="Full" ;;
    4)
        echo ""
        echo "Available flags:"
        echo "  --fast --crawl --httpx --nuclei --secrets --cors"
        echo "  --js --s3 --soft404 --dirbrute --params --resume"
        echo ""
        read -p "Flags: " FLAGS
        TYPE="Custom"
        ;;
    5)
        clear
        echo "🌐 Starting Dashboard on http://localhost:8000"
        termux-open-url http://localhost:8000 >/dev/null 2>&1 &
        python -m reconx.web
        exit 0
        ;;
    *) echo "❌ Invalid"; exit 1 ;;
esac

echo ""
read -p "⚙️  Threads [15]: " THREADS
THREADS=${THREADS:-15}

echo ""
echo "═══════════════════════════════════════════"
echo "  🎯 Target:   $DOMAIN"
echo "  📋 Mode:     $TYPE"
echo "  ⚙️  Threads:  $THREADS"
echo "  🕐 Started:  $(date '+%H:%M:%S')"
echo "═══════════════════════════════════════════"
echo ""
read -p "Start scan? [Y/n]: " CONFIRM
if [[ ! "$CONFIRM" =~ ^[Yy]?$ ]]; then
    echo "Cancelled."
    exit 0
fi

echo ""
termux-wake-lock 2>/dev/null
python -m reconx -d "$DOMAIN" $FLAGS -t "$THREADS"
RESULT=$?
termux-wake-unlock 2>/dev/null

if [ $RESULT -eq 0 ]; then
    OUT_DIR=~/reconx/output/"$DOMAIN"
    if [ -d "$OUT_DIR" ]; then
        echo ""
        echo "═══════════════════════════════════════════"
        echo "  ✅ SCAN COMPLETE"
        echo "═══════════════════════════════════════════"
        echo ""

        if [ -f "$OUT_DIR/${DOMAIN}_live.txt" ]; then
            echo "  ✓ Live hosts:      $(wc -l < "$OUT_DIR/${DOMAIN}_live.txt")"
        fi
        if [ -f "$OUT_DIR/${DOMAIN}_endpoints.txt" ]; then
            echo "  ✓ Endpoints:       $(wc -l < "$OUT_DIR/${DOMAIN}_endpoints.txt")"
        fi
        if [ -f "$OUT_DIR/${DOMAIN}_dirbrute.txt" ]; then
            echo "  ✓ Dirbrute:        $(grep -c '^  \[' "$OUT_DIR/${DOMAIN}_dirbrute.txt" 2>/dev/null || echo 0)"
        fi
        if [ -f "$OUT_DIR/${DOMAIN}.db" ]; then
            NC=$(sqlite3 "$OUT_DIR/${DOMAIN}.db" "SELECT COUNT(*) FROM hosts WHERE nuclei != '[]' AND nuclei IS NOT NULL" 2>/dev/null || echo "0")
            echo "  ✓ Nuclei findings: $NC"
        fi

        echo ""
        echo "📄 Output files:"
        ls -1 "$OUT_DIR" 2>/dev/null | grep -E '\.(txt|csv|json|db|md|html)$' | while read f; do
            SIZE=$(du -h "$OUT_DIR/$f" 2>/dev/null | cut -f1)
            echo "  • $f ($SIZE)"
        done

        if [ -f "$OUT_DIR/${DOMAIN}_report.html" ]; then
            cp "$OUT_DIR/${DOMAIN}_report.html" ~/storage/downloads/ 2>/dev/null && \
                echo ""
                echo "📱 HTML report: ~/storage/downloads/${DOMAIN}_report.html"
        fi
        echo ""
    fi
else
    echo "❌ Scan failed (exit: $RESULT)"
fi

echo "Done 👋"
echo ""
